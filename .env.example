# ── Contact-form lead delivery (Resend) ──────────────────────────────
# Copy this file to `.env.local` and fill in real values. `.env.local` is gitignored.

# API key from https://resend.com (Dashboard → API Keys). Required to send mail.
RESEND_API_KEY=

# Where leads are delivered (your dad's inbox).
LEAD_TO_EMAIL=

# From address shown on the email. Must be on a Resend-verified domain.
# Until harmac.fi is verified, leave blank to use Resend's shared test sender.
# Example once verified:  LEAD_FROM_EMAIL=Harmac Web <make@harmac.fi>
LEAD_FROM_EMAIL=
